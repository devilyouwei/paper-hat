# ============================================================
# Paper agent configuration (copy to config.env and fill in).
#   cp config.example.env config.env
# config.env is gitignored. The scripts auto-load it.
# ============================================================

# --- LLM (OpenAI-compatible) used for citation-graph extraction ---
# Works with OpenAI, Azure OpenAI, DeepSeek, local vLLM/Ollama, etc.
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: max characters of PDF text fed to the LLM per paper.
LLM_MAX_CHARS=24000

# --- Semantic Scholar (metadata enrichment & citations) ---
# Optional. Without a key you get a lower, shared rate limit.
# Request one at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
