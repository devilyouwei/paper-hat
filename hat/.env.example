# Copy to .env and fill in. Loaded automatically via pydantic-settings.

HAT_ENV=dev
HAT_LOG_LEVEL=INFO

# --- Selection coefficients (paper §3.4.2 / §4) ---
HAT_ALPHA=0.4
HAT_BETA=0.4
HAT_GAMMA=0.2
HAT_WRITE_THRESHOLD=0.3
HAT_ORACLE_THRESHOLD=0.7

# --- Cortex backend ---
# Pick the runtime. Concrete model weights are downloaded via the UI / API
# into model/<backend>/<id>/ — there are no fixed model paths here.
#   noop : echo stub (default, zero deps)
#   mlx  : Apple-Silicon native (Metal) via mlx-lm; M1/M2/M3 Macs
#   hf   : HuggingFace Transformers; CPU / CUDA / MPS via HAT_HF_DEVICE
HAT_CORTEX_BACKEND=hf

# HF hardware preferences (only relevant when HAT_CORTEX_BACKEND=hf)
HAT_HF_DEVICE=auto         # auto | cpu | cuda | mps
HAT_HF_DTYPE=auto          # auto | float16 | bfloat16 | float32

# Default generation params (server-side fallback when the client does not
# pass temperature / max_tokens; the Gradio UI exposes per-call overrides).
HAT_DEFAULT_TEMPERATURE=0.7
HAT_DEFAULT_MAX_TOKENS=512

# --- Oracle (OpenAI-compatible HTTP; works for GPT-4o / vLLM-served / Ollama) ---
HAT_ORACLE_BASE_URL=https://api.openai.com/v1
HAT_ORACLE_MODEL=gpt-5.1
HAT_ORACLE_API_KEY=