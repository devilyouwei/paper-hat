# Copy to .env and fill in. Loaded automatically via pydantic-settings.

HAT_ENV=dev
HAT_LOG_LEVEL=INFO

# --- Selection coefficients (paper §3.4.2 / §4) ---
HAT_ALPHA=0.4
HAT_BETA=0.4
HAT_GAMMA=0.2
HAT_WRITE_THRESHOLD=0.3
HAT_ORACLE_THRESHOLD=0.7

# --- Storage ---
HAT_RAW_LOG_PATH=runs/raw_log.jsonl
HAT_NEOCORTEX_PATH=runs/neocortex.jsonl

# --- Cortex backend ---
# noop  : echo stub (default, zero deps)
# hf    : local HuggingFace model loaded from HAT_HF_MODEL_PATH
# mlx   : Apple-Silicon native (Metal) via mlx-lm; best for M1/M2/M3 Macs
HAT_CORTEX_BACKEND=noop
HAT_HF_MODEL_PATH=./model
HAT_HF_DEVICE=auto
HAT_HF_DTYPE=auto
HAT_HF_MAX_NEW_TOKENS=512
HAT_HF_TEMPERATURE=0.7

# --- MLX (Apple Silicon) ---
# Path to a local mlx-format model dir, OR a HuggingFace repo id like
# "mlx-community/Qwen2.5-1.5B-Instruct-4bit" (mlx-lm will fetch on first use).
HAT_MLX_MODEL_PATH=mlx-community/Qwen2.5-1.5B-Instruct-4bit
HAT_MLX_MAX_TOKENS=512
HAT_MLX_TEMPERATURE=0.7

# --- Oracle (OpenAI-compatible HTTP; works for GPT-4o / vLLM-served / Ollama) ---
HAT_ORACLE_BASE_URL=https://api.openai.com/v1
HAT_ORACLE_MODEL=gpt-4o-mini
HAT_ORACLE_API_KEY=

# --- Gradio UI: where to find the OpenAI-compatible HAT server ---
HAT_UI_BASE_URL=http://127.0.0.1:8000/v1
HAT_UI_MODEL=hat-cortex
